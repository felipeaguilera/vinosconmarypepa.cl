---
import type { EventoData } from '../../lib/eventos';

interface Props {
  evento: EventoData;
}

const { evento } = Astro.props;

const ciudadComuna = [evento.lugar.comuna, evento.lugar.ciudad].filter(Boolean).join(', ');
const fotosLugar = evento.lugar.fotos && evento.lugar.fotos.length > 0 ? evento.lugar.fotos : [];
---

<section class="evento-seccion seccion-ubicacion" id="ubicacion">
  <div class="seccion-contenedor">
    <h2 class="seccion-titulo">Ubicación</h2>

    <div class="tarjeta-ubicacion">
      <div class="ubicacion-info">
        <h3 class="lugar-nombre">{evento.lugar.nombre}</h3>
        {evento.lugar.detalle && <p class="lugar-detalle">{evento.lugar.detalle}</p>}
        {evento.lugar.direccion && <p class="lugar-direccion">{evento.lugar.direccion}</p>}
        {ciudadComuna && <p class="lugar-ciudad">{ciudadComuna}</p>}
      </div>

      {evento.lugar.urlMapa && (
        <div class="ubicacion-mapa-cta">
          <a
            href={evento.lugar.urlMapa}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-mapa"
          >
            Ver en Google Maps &rarr;
          </a>
        </div>
      )}
    </div>

    {fotosLugar.length > 0 && (
      <div class={`galeria-lugar ${fotosLugar.length === 1 ? 'una-foto' : ''}`}>
        {fotosLugar.map((foto) => (
          <figure class="foto-item">
            <img
              src={foto.archivo}
              alt={foto.alt}
              loading="lazy"
              class="foto-img"
            />
          </figure>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .evento-seccion {
    padding: 3rem 0;
    border-bottom: 1px solid var(--border);
  }

  .seccion-contenedor {
    max-width: var(--maxw);
    margin: 0 auto;
    text-align: center;
  }

  .seccion-titulo {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    color: var(--accent);
    line-height: 1.2;
    margin-bottom: 1.5rem;
    font-style: italic;
    font-weight: 600;
  }

  .tarjeta-ubicacion {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-align: left;
    margin-bottom: 2rem;
  }

  .ubicacion-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .lugar-nombre {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--text);
    font-weight: 600;
    line-height: 1.25;
  }

  .lugar-detalle {
    font-size: 0.9375rem;
    color: var(--accent);
    font-weight: 500;
  }

  .lugar-direccion {
    font-size: 0.9375rem;
    color: var(--text);
    line-height: 1.5;
  }

  .lugar-ciudad {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .ubicacion-mapa-cta {
    margin-top: 0.5rem;
  }

  .btn-mapa {
    display: inline-block;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 0.6rem 1.15rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .btn-mapa:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Galería del Lugar */
  .galeria-lugar {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .galeria-lugar.una-foto {
    grid-template-columns: 1fr;
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
  }

  .foto-item {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .foto-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.25s ease;
  }

  .foto-item:hover .foto-img {
    transform: scale(1.02);
  }

  @media (min-width: 640px) {
    .evento-seccion {
      padding: 3.5rem 0;
    }

    .tarjeta-ubicacion {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 2rem;
    }

    .ubicacion-mapa-cta {
      margin-top: 0;
      flex-shrink: 0;
    }

    .galeria-lugar {
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.25rem;
    }
  }
</style>
