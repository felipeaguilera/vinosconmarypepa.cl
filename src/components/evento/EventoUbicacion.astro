---
import type { EventoData } from '../../lib/eventos';

interface Props {
  evento: EventoData;
}

const { evento } = Astro.props;

const ciudadComuna = [evento.lugar.comuna, evento.lugar.ciudad].filter(Boolean).join(', ');
const consultaMapa = `${evento.lugar.nombre}, ${evento.lugar.direccion}, ${evento.lugar.comuna}, ${evento.lugar.ciudad}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(consultaMapa)}&t=&z=16&ie=UTF8&iwloc=&output=embed`;
---

<section class="evento-seccion seccion-ubicacion" id="ubicacion">
  <div class="seccion-contenedor">
    <div class="ubicacion-grid">
      <!-- Mapa interactivo Google Maps -->
      <div class="mapa-contenedor">
        <iframe
          src={mapEmbedUrl}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Ubicación de ${evento.lugar.nombre}`}
          class="mapa-iframe"
        ></iframe>
      </div>

      <!-- Tarjeta informativa del lugar -->
      <div class="ubicacion-tarjeta">
        <span class="ubicacion-eyebrow">Ubicación</span>
        <h2 class="lugar-nombre">{evento.lugar.nombre}</h2>
        {evento.lugar.detalle && <p class="lugar-detalle">{evento.lugar.detalle}</p>}
        {evento.lugar.direccion && <p class="lugar-direccion">{evento.lugar.direccion}</p>}
        {ciudadComuna && <p class="lugar-ciudad">{ciudadComuna}</p>}

        {evento.lugar.urlMapa && (
          <div class="ubicacion-cta">
            <a
              href={evento.lugar.urlMapa}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-mapa"
            >
              Ver en Google Maps &rarr;
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .evento-seccion {
    padding: 3rem 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .seccion-contenedor {
    max-width: var(--maxw-ancho);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .ubicacion-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .mapa-contenedor {
    width: 100%;
    min-height: 280px;
    height: 320px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    background: var(--surface);
  }

  .mapa-iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: none;
  }

  .ubicacion-tarjeta {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    text-align: left;
  }

  .ubicacion-eyebrow {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .lugar-nombre {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.15rem);
    color: var(--accent);
    font-style: italic;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .lugar-detalle {
    font-size: 1.0625rem;
    color: var(--text);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .lugar-direccion {
    font-size: 0.9375rem;
    color: var(--text);
    line-height: 1.5;
    margin-bottom: 0.25rem;
  }

  .lugar-ciudad {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .ubicacion-cta {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .btn-mapa {
    display: inline-block;
    background: var(--bg);
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-mapa:hover {
    background: var(--accent);
    color: #ffffff;
  }

  @media (min-width: 768px) {
    .evento-seccion {
      padding: 4.5rem 0;
    }

    .seccion-contenedor {
      padding: 0 1.5rem;
    }

    .ubicacion-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 2rem;
    }

    .mapa-contenedor {
      min-height: 380px;
      height: 100%;
    }

    .ubicacion-tarjeta {
      padding: 2.5rem 2.25rem;
    }
  }
</style>
