---
import type { EventoData } from '../../lib/eventos';

interface Props {
  evento: EventoData;
}

const { evento } = Astro.props;

const tieneRestricciones = Boolean(evento.restricciones && evento.restricciones.length > 0);
---

{tieneRestricciones && (
  <section class="evento-seccion seccion-informacion" id="informacion">
    <div class="seccion-contenedor">
      <h2 class="seccion-titulo">Información</h2>
      <ul class="lista-restricciones">
        {evento.restricciones.map((item) => (
          <li class="item-restriccion">{item}</li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .evento-seccion {
    padding: 1.5rem 0;
    background: transparent;
    border-top: 1px solid var(--border);
  }

  .seccion-contenedor {
    max-width: var(--maxw-ancho);
    margin: 0 auto;
    padding: 0 1.25rem;
    text-align: center;
  }

  .seccion-titulo {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 0.5rem;
    opacity: 0.85;
  }

  .lista-restricciones {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 1.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .item-restriccion {
    display: inline-flex;
    align-items: center;
  }

  @media (min-width: 640px) {
    .evento-seccion {
      padding: 1.75rem 0;
    }

    .seccion-contenedor {
      padding: 0 1.5rem;
    }

    .item-restriccion:not(:last-child)::after {
      content: '·';
      margin-left: 1.25rem;
      color: var(--border);
      font-weight: 700;
    }
  }
</style>
