---
import type { EventoData } from '../../lib/eventos';

interface Props {
  evento: EventoData;
}

const { evento } = Astro.props;

const tieneRestricciones = Boolean(evento.restricciones && evento.restricciones.length > 0);
---

{tieneRestricciones && (
  <section class="evento-seccion seccion-mas-info" id="mas-info">
    <div class="seccion-contenedor">
      <h2 class="seccion-titulo">Más información</h2>
      <ul class="lista-restricciones">
        {evento.restricciones.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .evento-seccion {
    padding: 2.5rem 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .seccion-contenedor {
    max-width: 540px;
    margin: 0 auto;
    padding: 0 1.5rem;
    text-align: center;
  }

  .seccion-titulo {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .lista-restricciones {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.9375rem;
    color: var(--text);
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .evento-seccion {
      padding: 3rem 0;
    }
  }
</style>
