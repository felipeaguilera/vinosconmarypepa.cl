---
import type { EventoData } from '../../lib/eventos';
import sitio from '../../data/sitio.json';

interface Props {
  evento: EventoData;
}

const { evento } = Astro.props;

const parrafosDescripcion = evento.descripcion
  ? evento.descripcion
      .split(/\n\s*\n/)
      .map((p) => p.trim())
      .filter(Boolean)
  : [];
---

<section class="evento-seccion seccion-presentacion" id="presentacion">
  <div class="seccion-contenedor">
    <!-- Bloque de presentación con foto de María Paz -->
    <div class="presentacion-grid">
      <div class="presentacion-foto">
        <img
          src="/assets/MariaPazJimenez-Portrait-Podcast-01.png"
          alt={sitio.organizadora}
          loading="lazy"
          class="presentacion-foto-img"
        />
      </div>

      <div class="presentacion-texto">
        <span class="presentacion-eyebrow">Vinos con Marypepa te invita a</span>
        <h2 class="presentacion-titulo">La Primera Feria solo con enólogas mujeres</h2>
        <p class="presentacion-bajada">
          Conoce a las enólogas que están dando que hablar en la industria del Vino Chileno.
        </p>
      </div>
    </div>

    <!-- Carrusel de Participantes integrado en la misma sección -->
    {evento.participantes && evento.participantes.length > 0 && (
      <div class="bloque-participantes" id="participantes">
        <div class="participantes-cabecera">
          <div class="participantes-titular">
            <h3 class="participantes-titulo">Participantes</h3>
            <span class="indicador-scroll" aria-label="Desliza horizontalmente para ver todas las participantes">
              <span class="flecha-scroll" aria-hidden="true">&#8592;</span> Desliza para ver más <span class="flecha-scroll" aria-hidden="true">&#8594;</span>
            </span>
          </div>

          <div class="carrusel-controles" aria-label="Controles de carrusel">
            <button type="button" class="btn-carrusel btn-prev" id="btn-enologas-prev" aria-label="Anterior">
              &#8592;
            </button>
            <button type="button" class="btn-carrusel btn-next" id="btn-enologas-next" aria-label="Siguiente">
              &#8594;
            </button>
          </div>
        </div>

        <div class="carrusel-wrapper">
          <div class="carrusel-enologas" id="carrusel-enologas">
          {evento.participantes.map((p) => {
            const tieneFoto = Boolean(p.foto && p.foto.trim());

            return (
              <article class="tarjeta-enologa-mini">
                {tieneFoto ? (
                  <div class="marco-foto-mini">
                    <img
                      src={p.foto}
                      alt={`${p.nombre}, ${p.vina}`}
                      loading="lazy"
                      class="enologa-img-mini"
                    />
                  </div>
                ) : (
                  <div class="marco-foto-mini marco-tipografico-mini">
                    <span class="enologa-iniciales">{p.nombre.split(' ').map(n => n[0]).slice(0, 2).join('')}</span>
                  </div>
                )}
                <div class="enologa-info-mini">
                  <h4 class="enologa-nombre-mini">{p.nombre}</h4>
                  <p class="enologa-vina-mini">{p.vina}</p>
                  {p.cargo && <p class="enologa-cargo-mini">{p.cargo}</p>}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </div>
    )}
  </div>
</section>

<script>
  function setupCarrusel() {
    const carrusel = document.getElementById('carrusel-enologas');
    const btnPrev = document.getElementById('btn-enologas-prev');
    const btnNext = document.getElementById('btn-enologas-next');

    if (!carrusel || !btnPrev || !btnNext) return;

    btnPrev.addEventListener('click', () => {
      carrusel.scrollBy({ left: -280, behavior: 'smooth' });
    });

    btnNext.addEventListener('click', () => {
      carrusel.scrollBy({ left: 280, behavior: 'smooth' });
    });
  }

  setupCarrusel();
  document.addEventListener('astro:page-load', setupCarrusel);
</script>

<style>
  .evento-seccion {
    padding: 3rem 0 2.5rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .seccion-contenedor {
    max-width: var(--maxw-ancho);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .presentacion-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .presentacion-foto {
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 10px;
    background: var(--bg);
    border: 1px solid var(--border);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .presentacion-foto-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .presentacion-texto {
    text-align: center;
  }

  .presentacion-eyebrow {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .presentacion-titulo {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.75rem, 4vw, 2.35rem);
    color: var(--accent);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .presentacion-bajada {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text);
    font-weight: 500;
    margin-bottom: 0;
  }

  /* Bloque de participantes */
  .bloque-participantes {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }

  .participantes-cabecera {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .participantes-titular {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: left;
  }

  .participantes-titulo {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.5vw, 1.65rem);
    color: var(--accent);
    line-height: 1.2;
    font-style: italic;
    font-weight: 600;
    margin: 0;
  }

  .indicador-scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .flecha-scroll {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.8125rem;
  }

  .carrusel-controles {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .btn-carrusel {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.875rem;
    transition: all 0.15s ease;
  }

  .btn-carrusel:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: #ffffff;
  }

  .carrusel-wrapper {
    position: relative;
  }

  .carrusel-enologas {
    display: flex;
    gap: 0.85rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.75rem;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .carrusel-enologas::-webkit-scrollbar {
    height: 4px;
  }

  .carrusel-enologas::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
  }

  .tarjeta-enologa-mini {
    flex: 0 0 115px;
    scroll-snap-align: start;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .marco-foto-mini {
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .marco-tipografico-mini {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(136, 0, 0, 0.05);
  }

  .enologa-iniciales {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .enologa-img-mini {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .enologa-info-mini {
    padding: 0.5rem 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex-grow: 1;
    justify-content: flex-start;
  }

  .enologa-nombre-mini {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.25;
    word-break: break-word;
  }

  .enologa-vina-mini {
    font-size: 0.6875rem;
    color: var(--accent);
    font-weight: 500;
    line-height: 1.25;
    word-break: break-word;
  }

  .enologa-cargo-mini {
    font-size: 0.625rem;
    color: var(--muted);
    line-height: 1.2;
    margin-top: 0.1rem;
  }

  @media (min-width: 640px) {
    .evento-seccion {
      padding: 4rem 0 3rem;
    }

    .seccion-contenedor {
      padding: 0 1.5rem;
    }

    .presentacion-grid {
      flex-direction: row;
      align-items: center;
      gap: 3.5rem;
      margin-bottom: 3.5rem;
    }

    .presentacion-foto {
      max-width: none;
      flex: 0 0 320px;
      margin: 0;
    }

    .presentacion-texto {
      text-align: left;
      flex: 1;
    }

    .presentacion-eyebrow {
      text-align: left;
    }

    .tarjeta-enologa-mini {
      flex: 0 0 125px;
    }

    .enologa-info-mini {
      padding: 0.6rem 0.5rem;
    }

    .enologa-nombre-mini {
      font-size: 0.8125rem;
    }

    .enologa-vina-mini {
      font-size: 0.75rem;
    }
  }
</style>
