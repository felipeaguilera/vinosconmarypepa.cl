---
import type { EventoData } from '../../lib/eventos';

interface Props {
  evento: EventoData;
}

const { evento } = Astro.props;

const lugarCompleto = [evento.lugar.nombre, evento.lugar.detalle].filter(Boolean).join(', ');
const tieneFondo = Boolean(evento.imagenes.hero && evento.imagenes.hero.trim());

const tieneLinkPago = Boolean(evento.pago.urlLink && evento.pago.urlLink.trim());
const hrefCompra = tieneLinkPago ? evento.pago.urlLink : '#entradas';
const targetCompra = tieneLinkPago ? '_blank' : undefined;
const relCompra = tieneLinkPago ? 'noopener noreferrer' : undefined;
---

<header class={`evento-hero textura-anillos ${tieneFondo ? 'con-fondo' : ''}`} id="hero">
  {tieneFondo && (
    <div class="hero-fondo" style={`background-image: url(${evento.imagenes.hero})`}>
      <div class="hero-velo" aria-hidden="true"></div>
    </div>
  )}

  <div class="hero-contenido">
    <img
      src="/assets/logos/marypepa-logo.svg"
      alt="Vinos con Marypepa"
      width="150"
      height="150"
      class="hero-logo"
    />

    <div class="hero-eyebrow">
      {evento.presenta && <span class="presenta">{evento.presenta} presenta</span>}
      {evento.serie && evento.presenta && <span class="separador" aria-hidden="true">·</span>}
      {evento.serie && <span class="serie">{evento.serie}</span>}
    </div>

    <h1 class="hero-titulo">{evento.titulo}</h1>

    {evento.bajada && <p class="hero-bajada">{evento.bajada}</p>}

    <div class="hero-datos-clave">
      {evento.fecha.textoVisible && (
        <span class="dato-item">{evento.fecha.textoVisible}</span>
      )}

      {lugarCompleto && (
        <>
          <span class="dato-separador" aria-hidden="true">&middot;</span>
          <span class="dato-item">{lugarCompleto}</span>
        </>
      )}

      {evento.precio.textoVisible && (
        <>
          <span class="dato-separador" aria-hidden="true">&middot;</span>
          <span class="dato-item dato-precio">{evento.precio.textoVisible}</span>
        </>
      )}
    </div>

    <div class="hero-cta-wrapper">
      <a
        href={hrefCompra}
        target={targetCompra}
        rel={relCompra}
        class="hero-btn-compra"
      >
        {evento.pago.textoBoton || 'COMPRA TU ENTRADA AQUÍ'}
      </a>
    </div>
  </div>
</header>

<style>
  .evento-hero {
    position: relative;
    padding: 2.5rem 1.5rem 2.5rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .evento-hero.con-fondo {
    padding: 3.5rem 1.5rem 3rem;
    border-bottom: none;
    color: var(--crema);
    overflow: hidden;
    background: var(--accent-oscuro);
  }

  .hero-fondo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 65%;
    z-index: 0;
  }

  .hero-velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 10, 9, 0.8) 0%,
      rgba(30, 6, 8, 0.72) 45%,
      rgba(10, 6, 6, 0.9) 100%
    );
  }

  .hero-contenido {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-logo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    display: block;
    margin: 0 auto 1.5rem;
    box-shadow: 0 0 0 4px rgba(242, 240, 228, 0.9), 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .con-fondo .hero-eyebrow {
    color: var(--crema);
    opacity: 0.85;
  }

  .hero-eyebrow .separador {
    color: var(--border);
  }

  .con-fondo .hero-eyebrow .separador {
    color: var(--crema);
    opacity: 0.4;
  }

  .hero-titulo {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2.5rem, 9vw, 4.5rem);
    line-height: 1.05;
    color: var(--accent);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .con-fondo .hero-titulo {
    color: var(--crema);
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.4);
  }

  .hero-bajada {
    max-width: 480px;
    margin: 0 auto 1.75rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .con-fondo .hero-bajada {
    color: var(--crema);
    opacity: 0.94;
  }

  .hero-datos-clave {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.6rem;
    margin: 0 auto 1.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .dato-item {
    color: var(--text);
  }

  .con-fondo .dato-item {
    color: var(--crema);
  }

  .dato-separador {
    color: var(--border);
  }

  .con-fondo .dato-separador {
    color: var(--crema);
    opacity: 0.4;
  }

  .dato-precio {
    font-weight: 700;
    color: var(--accent);
  }

  .con-fondo .dato-precio {
    color: var(--crema);
  }

  .hero-cta-wrapper {
    margin-top: 0.5rem;
  }

  .hero-btn-compra {
    display: inline-block;
    background: var(--accent);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.85rem 2.25rem;
    border-radius: 6px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(136, 0, 0, 0.25);
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .hero-btn-compra:hover {
    background: #6e0000;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(136, 0, 0, 0.35);
  }

  .con-fondo .hero-btn-compra {
    background: var(--crema);
    color: var(--accent);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
  }

  .con-fondo .hero-btn-compra:hover {
    background: #ffffff;
    color: var(--accent-oscuro, #500000);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
  }

  @media (min-width: 640px) {
    .evento-hero {
      padding: 4rem 1.5rem 3.5rem;
    }

    .evento-hero.con-fondo {
      padding: 6rem 1.5rem 4.5rem;
    }

    .hero-datos-clave {
      font-size: 1.0625rem;
    }

    .hero-logo {
      width: 150px;
      height: 150px;
      margin-bottom: 1.75rem;
    }

    .hero-btn-compra {
      font-size: 1.0625rem;
      padding: 0.95rem 2.75rem;
    }
  }
</style>
