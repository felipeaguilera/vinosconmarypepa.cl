---
import type { EventoData } from '../../lib/eventos';

interface Props {
  evento: EventoData;
}

const { evento } = Astro.props;

const lugarCompleto = [evento.lugar.nombre, evento.lugar.detalle].filter(Boolean).join(', ');
---

<header class="evento-hero" id="hero">
  <div class="hero-eyebrow">
    {evento.serie && <span class="serie">{evento.serie}</span>}
    {evento.serie && evento.presenta && <span class="separador" aria-hidden="true">·</span>}
    {evento.presenta && <span class="presenta">Presenta {evento.presenta}</span>}
  </div>

  <h1 class="hero-titulo">{evento.titulo}</h1>

  <div class="hero-datos-clave">
    {evento.fecha.textoVisible && (
      <div class="dato-item">
        <span class="dato-label">Fecha y hora</span>
        <span class="dato-valor">{evento.fecha.textoVisible}</span>
      </div>
    )}

    {lugarCompleto && (
      <div class="dato-item">
        <span class="dato-label">Lugar</span>
        <span class="dato-valor">{lugarCompleto}</span>
      </div>
    )}

    {evento.precio.textoVisible && (
      <div class="dato-item dato-precio">
        <span class="dato-label">Entrada general</span>
        <span class="dato-valor valor-precio">{evento.precio.textoVisible}</span>
      </div>
    )}
  </div>

  <div class="hero-scroll-hint">
    <a href="#entradas" class="hero-link-entradas">
      Ver detalles y entradas &darr;
    </a>
  </div>
</header>

<style>
  .evento-hero {
    padding: 2.5rem 0 2rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .hero-eyebrow .separador {
    color: var(--border);
  }

  .hero-titulo {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2.5rem, 8vw, 4.25rem);
    line-height: 1.08;
    color: var(--accent);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  .hero-datos-clave {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    max-width: 540px;
    margin: 0 auto 1.5rem;
    text-align: left;
  }

  .dato-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .dato-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-weight: 500;
  }

  .dato-valor {
    font-size: 0.9375rem;
    color: var(--text);
    font-weight: 500;
    line-height: 1.35;
  }

  .dato-precio .valor-precio {
    color: var(--accent);
    font-weight: 600;
    font-size: 1.125rem;
  }

  .hero-scroll-hint {
    margin-top: 0.5rem;
  }

  .hero-link-entradas {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .hero-link-entradas:hover {
    color: var(--accent);
    background-color: var(--accent-lt);
  }

  @media (min-width: 640px) {
    .evento-hero {
      padding: 3.5rem 0 3rem;
    }

    .hero-datos-clave {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      padding: 1.5rem;
    }

    .dato-item {
      border-right: 1px solid var(--border);
      padding-right: 1rem;
    }

    .dato-item:last-child {
      border-right: none;
      padding-right: 0;
    }
  }
</style>
