---
import sitio from '../data/sitio.json';
import type { EventoData } from '../lib/eventos';

interface Props {
  evento: EventoData;
}

const { evento } = Astro.props;

const esTransferencia = evento.pago.proveedor === 'transferencia' || (!evento.pago.urlLink?.trim() && Boolean(evento.pago.transferencia));
const ventaActiva = evento.pago.estado === 'activo' && (Boolean(evento.pago.urlLink?.trim()) || esTransferencia);
const hrefBoton = (!esTransferencia && evento.pago.urlLink?.trim()) ? evento.pago.urlLink : '#';
const textoBoton = evento.pago.textoBoton || 'COMPRA TU ENTRADA AQUÍ';
---

<header class="site-header">
  <div class="site-header-contenedor">
    <a href="/" class="site-header-logo" title="Vinos con Marypepa presenta: Club Label Woman Wine">
      <span class="site-header-nombre">Vinos con Marypepa presenta: Club Label Woman Wine</span>
    </a>

    <a
      href={hrefBoton}
      class="site-header-boton"
      target={(!esTransferencia && ventaActiva) ? '_blank' : undefined}
      rel={(!esTransferencia && ventaActiva) ? 'noopener noreferrer' : undefined}
      data-abrir-transferencia={esTransferencia ? '' : undefined}
    >
      {textoBoton}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(136, 0, 0, 0.96);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(242, 240, 228, 0.15);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.18);
  }

  .site-header-contenedor {
    max-width: var(--maxw-ancho);
    margin: 0 auto;
    padding: 0 1rem;
    height: var(--header-alto);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .site-header-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--crema);
    min-width: 0;
    flex: 1;
  }

  .site-header-nombre {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 0.875rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .site-header-boton {
    background: var(--crema);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.5rem 0.85rem;
    border-radius: 6px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    letter-spacing: 0.02em;
    transition: background-color 0.15s ease, transform 0.1s ease;
  }

  .site-header-boton:hover {
    background: #ffffff;
    transform: translateY(-1px);
  }

  @media (min-width: 640px) {
    .site-header-contenedor {
      padding: 0 1.5rem;
      gap: 1.5rem;
    }

    .site-header-nombre {
      font-size: 1.0625rem;
    }

    .site-header-boton {
      font-size: 0.8125rem;
      padding: 0.55rem 1.15rem;
    }
  }
</style>
